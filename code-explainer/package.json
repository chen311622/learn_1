{"name":"code-explainer","displayName":"Code Explainer","description":"解释代码 / 生成注释，支持本地 Ollama 与付费 API","version":"0.0.1","publisher":"your-publisher-name","engines":{"vscode":"^1.85.0"},"categories":["Other"],"main":"./out/extension.js","contributes":{"commands":[{"command":"code-explainer.explainCode","title":"解释这段代码"},{"command":"code-explainer.generateComment","title":"为这段代码生成注释"}],"menus":{"editor/context":[{"command":"code-explainer.explainCode","when":"editorHasSelection","group":"navigation@1"},{"command":"code-explainer.generateComment","when":"editorHasSelection","group":"navigation@2"}]},"configuration":{"title":"Code Explainer","properties":{"codeExplainer.provider":{"type":"string","enum":["ollama","openai"],"default":"ollama","description":"模型来源：本地 Ollama 或付费 API"},"codeExplainer.ollama.endpoint":{"type":"string","default":"http://localhost:11434"},"codeExplainer.ollama.model":{"type":"string","default":"qwen2.5-coder:7b"},"codeExplainer.openai.baseUrl":{"type":"string","default":"https://api.openai.com/v1"},"codeExplainer.openai.apiKey":{"type":"string","default":""},"codeExplainer.openai.model":{"type":"string","default":"gpt-4o-mini"}}}},"scripts":{"vscode:prepublish":"npm run compile","compile":"tsc -p ./","watch":"tsc -watch -p ./"},"devDependencies":{"@types/vscode":"^1.85.0","@types/node":"^20.11.0","typescript":"^5.4.0"}}