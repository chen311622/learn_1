{"name":"code-explainer","displayName":"Code Explainer","description":"解释代码 / 生成注释，支持本地 Ollama、OpenAI 与 DeepSeek","version":"0.0.2","publisher":"your-publisher-name","engines":{"vscode":"^1.85.0"},"categories":["Other"],"repository":{"type":"git","url":"https://github.com/chen311622/learn_1.git"},"main":"./out/extension.js","contributes":{"commands":[{"command":"code-explainer.explainCode","title":"解释这段代码"},{"command":"code-explainer.generateComment","title":"为这段代码生成注释"},{"command":"code-explainer.selectModel","title":"Code Explainer: 切换模型 / 服务商"}],"menus":{"editor/context":[{"command":"code-explainer.explainCode","when":"editorHasSelection","group":"navigation@1"},{"command":"code-explainer.generateComment","when":"editorHasSelection","group":"navigation@2"},{"command":"code-explainer.selectModel","when":"editorHasSelection","group":"navigation@3"}]},"configuration":{"title":"Code Explainer","properties":{"codeExplainer.provider":{"type":"string","enum":["ollama","openai","deepseek"],"default":"ollama","description":"模型来源：本地 Ollama、OpenAI 或 DeepSeek（OpenAI 兼容接口）"},"codeExplainer.ollama.endpoint":{"type":"string","default":"http://localhost:11434"},"codeExplainer.ollama.model":{"type":"string","default":"qwen2.5-coder:7b"},"codeExplainer.openai.baseUrl":{"type":"string","default":"https://api.openai.com/v1"},"codeExplainer.openai.apiKey":{"type":"string","default":""},"codeExplainer.openai.model":{"type":"string","default":"gpt-4o-mini"},"codeExplainer.deepseek.baseUrl":{"type":"string","default":"https://api.deepseek.com","description":"DeepSeek API 地址（OpenAI 兼容）"},"codeExplainer.deepseek.apiKey":{"type":"string","default":"","description":"DeepSeek API Key"},"codeExplainer.deepseek.model":{"type":"string","default":"deepseek-flash","description":"DeepSeek 模型名，例如 deepseek-flash（V4.1 Flash）/ deepseek-v4-pro"}}}},"scripts":{"vscode:prepublish":"npm run compile","compile":"tsc -p ./","watch":"tsc -watch -p ./"},"devDependencies":{"@types/vscode":"^1.85.0","@types/node":"^20.11.0","typescript":"^5.4.0"}}